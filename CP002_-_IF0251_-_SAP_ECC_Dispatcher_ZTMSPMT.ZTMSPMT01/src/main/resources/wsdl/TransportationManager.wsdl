								code should exist.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for shippingLocationTypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID code of the shipping location. Mandatory. Not
								updatable.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="UserStatusChangeInfoType"><xsd:annotation><xsd:documentation>A collection of information for the user status to change
						to.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="UserCode" type="p0:UserCodeType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>A collection of user codes.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UserStatusEnumVal" type="p0:UserStatusEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The new status of the user.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="VariableLoadingUnloadingTimeType"><xsd:annotation><xsd:documentation>Defines a variable loading or unloading time factor.
						Multiple entries may be applied to a single entity based on Load Unit Type.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="VariableLoadingUnloadingTimeCode" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>An automatically generated system identifier.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="VariableTimeCategoryEnumVal" type="p0:VariableTimeCategoryEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>Defines whether the variable time factor is for
								loading or unloading time. Mandatory. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="VariableTimeCategoryEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for variableTimeCategoryEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="VariableLoadingUnitTypeEnumVal" type="p0:LoadUnitEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The shipment attribute that this variable time
								factor is based on. Mandatory. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="VariableLoadingUnitTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for VariableLoadingUnitTypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UnitDivideFactorVal" type="p0:UnitDivideFactorType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Factor to scale a unit expression by. For example, a
