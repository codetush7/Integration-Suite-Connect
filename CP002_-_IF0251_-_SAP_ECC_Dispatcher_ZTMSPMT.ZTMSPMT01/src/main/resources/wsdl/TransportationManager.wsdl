								single transport order.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ItnrTimeTable" type="p0:ItnrTimeTableType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>A list of itinerary timetables.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ItnrLanePerformance" type="p0:ItnrLanePerformanceType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>A list of itinerary lane performance.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ItnrTimeTableEntry" type="p0:ItnrTimeTableEntryType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>A list of timetable entries.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="ElapsedPntTimeTableType"><xsd:annotation><xsd:documentation>A timetable point based on elapsed business days.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.
