documentation></xsd:annotation></xsd:element><xsd:element name="TariffDivision" type="p0:DivisionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The division ID of the Tariff. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffGroup" type="p0:TariffGroupDomainValueType" minOccurs="0"><xsd:annotation><xsd:documentation>The tariff group. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RateTypeEnumVal" type="p0:RateTypeEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The rate type. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffStatusEnumVal" type="p0:TariffStatusEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The tariff status. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tariff service code. Mandatory.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RestrictedUseFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the access to tariff service is
