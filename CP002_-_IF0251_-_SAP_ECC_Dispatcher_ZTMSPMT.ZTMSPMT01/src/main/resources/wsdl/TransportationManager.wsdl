:UserCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The spot rate user ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tariff service.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The tariff ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EquipmentTypeCode" type="p0:EquipmentTypeCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer equipment type .</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorEquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor equipment type.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor domicile code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTrailerCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer domicile code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Distance" type="p0:DistanceType" minOccurs="0"><xsd:annotation><xsd:documentation>The distance that the freight is being shipped.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The carrier ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceEngine" type="p0:ExternalEngineVersionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The external engine version (distance engine) code.
