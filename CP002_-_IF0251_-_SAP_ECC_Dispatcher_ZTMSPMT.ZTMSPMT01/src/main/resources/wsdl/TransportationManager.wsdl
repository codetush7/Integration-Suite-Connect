ceNumberTypeCode" type="p0:ReferenceNumDomainValueType" minOccurs="0"><xsd:annotation><xsd:documentation>The reference number type code. Optional.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="ServiceCrossReferenceType"><xsd:annotation><xsd:documentation>A service cross-reference.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="ExternalCode" type="p0:ExternalXRefType" minOccurs="0"><xsd:annotation><xsd:documentation>The external code. Mandatory. May not be empty.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The service code. Optional.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="ShipmentSplitRuleType"><xsd:annotation><xsd:documentation>Shipment split rule for shipping location.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID code of the shipping location. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationTypeEnumVal" type="p0:ShipPointEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The shipping location type for the shipment split
