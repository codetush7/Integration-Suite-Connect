0"><xsd:annotation><xsd:documentation>The trailer domicile of the rate quotation.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="PickupDate" type="xsd:date" minOccurs="0"><xsd:annotation><xsd:documentation>The pick-up date of the rate quotation. Not used if
