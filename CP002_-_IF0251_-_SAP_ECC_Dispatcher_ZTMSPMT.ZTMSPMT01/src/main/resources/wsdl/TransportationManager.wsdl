								new skeleton route (Create New).</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemPlanID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The system-generated Plan ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EffectiveDate" type="xsd:date" minOccurs="0"><xsd:annotation><xsd:documentation>The effective date. Cannot be an empty element.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ExpirationDate" type="xsd:date" minOccurs="0"><xsd:annotation><xsd:documentation>The expiration date. Cannot be an empty element.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The Carrier ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the carrier. Read-only. Available
								only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The Service ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the service. Read-only. Available
								only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTractorCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor domicile ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTractorDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor domicile description. Read-only.
								Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorEquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor equipment type.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorEquipmentTypeDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the tractor equipment type.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTrailerCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer domicile ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTrailerDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer domicile description. Read-only.
								Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerEquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer equipment type.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerEquipmentTypeDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the trailer equipment type.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StartTime" type="xsd:time" minOccurs="0"><xsd:annotation><xsd:documentation>The start time (time of day) for the very first
								occurrence within a load generation period.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LastScheduledDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>Scheduled date and time for the last generated load.
								Can be overridden.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="NumberOfSkeletonLocations" type="p0:UnsignedLongType" minOccurs="0"><xsd:annotation><xsd:documentation>The number of skeleton locations. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="IgnoreSkeletonLocationFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the contents of Location should be
								ignored.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Location" type="p0:SkeletonLocationType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation><![CDATA[A skeleton location. Ignored if
