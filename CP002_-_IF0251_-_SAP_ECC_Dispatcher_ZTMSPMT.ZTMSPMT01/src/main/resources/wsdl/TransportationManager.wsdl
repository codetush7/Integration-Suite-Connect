								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The shipping location ID. Mandatory for a new
								skeleton location.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationName" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the shipping location. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationAddress" type="p0:AddressType" minOccurs="0"><xsd:annotation><xsd:documentation>The address of the shipping location. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CommodityCode" type="p0:CommodityCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The commodity ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StopTypeEnumVal" type="p0:StopEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The stop type. Mandatory for a new skeleton
								location.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StopTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for StopTypeEnumVal. Read-only.
								Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StopDurationHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>The estimated variable stop duration.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EarliestServiceTimeActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether EarliestServiceTime and
