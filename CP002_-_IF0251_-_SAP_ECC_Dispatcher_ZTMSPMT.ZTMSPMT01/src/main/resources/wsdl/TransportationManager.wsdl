								update.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="BuyerSellerEnumVal" type="p0:INCOBuyerSellerEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>A description of the buyer and seller relationship.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="BuyerSellerEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for BuyerSellerEnumVal. Read-only.
								Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="OriginShippingLocationCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The origin shipping location code. Optional. Not
								modifiable during update.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="OriginShippingLocationTypeEnumVal" type="p0:ShipFromPointEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The origin shipping location type (load-at, hub or
								distribution center). Optional. Not modifiable during update.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="OriginShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for originShippingLocationTypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DestinationShippingLocationCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The destination shipping location code. Optional.
								Not modifiable during update.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DestinationShippingLocationTypeEnumVal" type="p0:ShipToPointEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The destination shipping location type (hub or
								distribution center, consignee). Optional. Not modifiable during
								update.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DestinationShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for
								destinationShippingLocationTypeEnumVal. Read-only. Available only
								through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DefaultIncoShippingLocationTypeEnumVal" type="p0:DefaultIncoShippingLocationTypeEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The Default Incoterms Shipping Location Type.
								Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DefaultIncoShippingLocationTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for
								defaultIncoShippingLocationTypeEnumVal. Read-only. Available only
								through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The date and time that the default Incoterms
								shipping locations were created. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The date and time that the default Incoterms
								shipping locations were updated. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CreatedByUserCode" type="p0:UserCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the user who created these default
								Incoterms shipping locations. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UpdatedByUserCode" type="p0:UserCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the user who updated these default
								Incoterms shipping locations. Read only field.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="DistanceTransitTimeType"><xsd:annotation><xsd:documentation>The Distance and Transit Time between two address points.
						All are output fields.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Distance" type="p0:DistanceType" minOccurs="0"><xsd:annotation><xsd:documentation>The distance from point A to point B. Expressed in
								the default distance UOM for the application, as defined in the
								global settings</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TransitTime" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>The transit time from point A to point B.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceEngineVersionCode" type="p0:ExternalEngineVersionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The distance engine ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceTransitTimeBreakdownString" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance transit time breakdowns, if applicable.
								String contains multiple breakdowns. Format of this string for each
								breakdown is represented by Distance in default distance UOM|Transit
								Time in hours|State Code|Country Code. For countries other than
								Mexico, Canada and USA, the state code will be empty. The difference
								beteen transitTime and the sum of the breakdown transit time caused
								by roudning will be adjusted in the last breakdown transit time.]]></xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="DistanceTransitTimeInputType"><xsd:annotation><xsd:documentation>The information about the Distance and Transit Time between
						two address points.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="DistanceTransitTimeOverride" type="p0:DistanceTransitTimeOverrideType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The data structure for CRUD of distance transit time
								override. It is also used here but not all the fields in this
								structure are needed for retrieving distance transit time.
								Basically, what is needed are the address information of point A and
								point B and the returning distance and time. Unlike the operations
								for override, Shipping Location Code can be empty here if the
								address information is provide.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="GeoCodeOverridenAFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the latitude or longitude values
								have been manually overridden for location A. If only shipping
								location code is provided, i.e. no address details, the address
								information will come from the address of the shipping location and
								this flag will be ignored.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="GeoCodeOverridenBFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the latitude or longitude values
								have been manually overridden for location B. If only shipping
								location code is provided, i.e. no address details, the address
								information will come from the address of the shipping location and
								this flag will be ignored.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="IncludeBreakdownFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether distance transit time breakdown
								should be included if applicalbe. For non override retreival only.
								Ignore otherwise.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="DistanceTransitTimeOverrideBreakdownType"><xsd:annotation><xsd:documentation><![CDATA[The information about the Distance and Transit Time Override
						Breakdown between two address points. Used also by
						processRetrieveDistanceTransitTime operation for output.]]></xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemDistanceTransitTimeOverrideBreakdownID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>An automatically generated system identifier.
								Ignored for Create as well as processRetrieveDistanceTransitTime.
								Read only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemDistanceTransitTimeOverrideID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The system ID of the parent distance transit time
								override. Read only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="BreakdownSequenceNumber" type="p0:UnsignedShortType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The sequence number of the breakdown in the
								breakdown list. Mandatory. Tne input sequence must match this value.
								The sequence number starts with zero. So, the first entry in the
								list will be zero, the second one will be one and so on.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether distance and transit time override
								breakdown is from point A to B Ignored if distinct distances and
								transit times by direction are not supported by or from point B to
								A. False is from A to B and vice versa. Read only.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StateCode" type="p0:StateCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The state which the breakdown belongs to. Mandatory
								for Mexico, Canada and USA. Empty otherwise.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CountryCode" type="p0:CountryCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The state which the breakdown belongs to. Mandatory.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Distance" type="p0:DistanceType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance breakdown for the specific state and /
								or country. Expressed in the default distance UOM for the
								application, as defined in the global settings. Mandatory.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TransitTime" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>The transit time for the specific state and / or
								country. Mandatory.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="DistanceTransitTimeOverrideType"><xsd:annotation><xsd:documentation><![CDATA[The information about the Distance and Transit Time Override
						between two address points. Used also by processRetrieveDistanceTransitTime
						operation for input.]]></xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemDistanceTransitTimeOverrideID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[An automatically generated system identifier.
								Ignored for Create as well as processRetrieveDistanceTransitTime.
								Mandatory for Retrieve, Update and Delete.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationATypeEnumVal" type="p0:ShipPointEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The type of the shipping location A. Used only for
								Create and processRetrieveDistanceTransitTime, ignored otherwise. If
								not supplied and ShippingLocationACode is supplied, one and only one
								shipping location with the code specified for location A should
								exist.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationATypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for ShippingLocationATypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationACode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The ID of the shipping location A. Mandatory for
								Create. Ignored for Retrieve, Update and Delete. For
								processRetrieveDistanceTransitTime, if not specified, distance /
								transit time overrides will not be considered for calculation. The
								address information of the shipping location will be used to create
								the distance / transit time override or calculate distance / transit
								time if address information is not provided (i.e. BlockLoc1,
								StreetLoc1, UnitLoc1, CityLoc1, StateLoc1, CountryCodeLoc1,
								PostalCodeLoc1, LatitudeLoc1 and LongitudeLoc1 are all empty).]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="BlockLoc1" type="p0:BlockNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The block (street) number of location A. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StreetLoc1" type="p0:StreetNameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The street name of location A. Mandatory for Create
								or processRetrieveDistanceTransitTime if not using default address
								of shipping location. Ignored if operation is not Create or
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UnitLoc1" type="p0:UnitNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The unit number of location A. Ignored if operation
								is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CityLoc1" type="p0:CityNameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The city name of location A. Mandatory for Create or
								processRetrieveDistanceTransitTime if not using default address of
								shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StateLoc1" type="p0:StateCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The state or province of location A. Mandatory for
								Create or processRetrieveDistanceTransitTime if not using default
								address of shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CountryCodeLoc1" type="p0:CountryCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The country of location A. Mandatory for Create or
								processRetrieveDistanceTransitTime if not using default address of
								shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="PostalCodeLoc1" type="p0:PostalCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The zip or postal code of location A. For Create or
								processRetrieveDistanceTransitTime, mandatory if postal codes are
								required for the country. Ignored otherwise. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LatitudeLoc1" type="p0:LatitudeType" minOccurs="0"><xsd:annotation><xsd:documentation>The latitude value of location A. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LongitudeLoc1" type="p0:LongitudeType" minOccurs="0"><xsd:annotation><xsd:documentation>The longitude value of location A. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="GeoCodeOverrideAFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the latitude / longitude values
								have been manually overridden for location A. Read-only, ignored in
								the input for any operation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationBTypeEnumVal" type="p0:ShipPointEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The type of the shipping location B. Used only for
								Create and processRetrieveDistanceTransitTime, ignored otherwise. If
								not supplied and ShippingLocationACode is supplied, one and only one
								shipping location with the code specified for location B should
								exist.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationBTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for ShippingLocationBTypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ShippingLocationBCode" type="p0:ShippingLocationCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The ID of the shipping location B. Mandatory for
								Create. Ignored for Retrieve, Update and Delete. For
								processRetrieveDistanceTransitTime, if not specified, distance /
								transit time overrides will not be considered for calculation. The
								address information of the shipping location will be used to create
								the distance / transit time override or calculate distance / transit
								time if address information is not provided (i.e. BlockLoc2,
								StreetLoc2, UnitLoc2, CityLoc2, StateLoc2, CountryCodeLoc2,
								PostalCodeLoc2, LatitudeLoc2 and LongitudeLoc2 are all empty).]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="BlockLoc2" type="p0:BlockNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The block (street) number of location B. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StreetLoc2" type="p0:StreetNameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The street name of location B. Mandatory for Create
								or processRetrieveDistanceTransitTime if not using default address
								of shipping location. Ignored if operation is not Create or
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UnitLoc2" type="p0:UnitNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The unit number of location B. Ignored if operation
								is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CityLoc2" type="p0:CityNameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The city name of location B. Mandatory for Create or
								processRetrieveDistanceTransitTime if not using default address of
								shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StateLoc2" type="p0:StateCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The state or province of location B. Mandatory for
								Create or processRetrieveDistanceTransitTime if not using default
								address of shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CountryCodeLoc2" type="p0:CountryCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The country of location B. Mandatory for Create or
								processRetrieveDistanceTransitTime if not using default address of
								shipping location. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="PostalCodeLoc2" type="p0:PostalCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The zip or postal code of location B. For Create or
								processRetrieveDistanceTransitTime, mandatory if postal codes are
								required for the country. Ignored otherwise. Ignored otherwise.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LatitudeLoc2" type="p0:LatitudeType" minOccurs="0"><xsd:annotation><xsd:documentation>The latitude value of location B. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LongitudeLoc2" type="p0:LongitudeType" minOccurs="0"><xsd:annotation><xsd:documentation>The longitude value of location B. Ignored if
								operation is not Create or processRetrieveDistanceTransitTime.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="GeoCodeOverrideBFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the latitude / longitude values
								have been manually overridden for location B. Read-only, ignored in
								the input for any operation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="OverrideActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether distance and transit time override
								from point A to point B is active. Ignored if distinct distances and
								transit times by direction are not supported by global settings of
								the system; otherwise, mandatory for Create, can be omitted for
								Update to avoid change. Ignored for
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Distance" type="p0:DistanceType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance from point A to point B. Expressed in
								the default distance UOM for the application, as defined in the
								global settings. If defined, must be greater than zero. Ignored if
								this direction is not active for the distance and transit time
								override; otherwise, mandatory for Create, can be omitted for Update
								to keep the existing value. This direction is always active when
								distinct distances and transit times by direction are not supported
								by global settings of the system. If
								distanceTransitOverrideBreakdown is provided, this field will be
								ignored. Ignored for processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TransitTime" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The transit time from point A to point B. If
								defined, must be greater than zero. Ignored if this direction is not
								active for the distance and transit time override; otherwise,
								mandatory for Create, can be omitted for Update to keep the existing
								value. This direction is always active when distinct distances and
								transit times by direction are not supported by global settings of
								the system. If distanceTransitOverrideBreakdown is provided, this
								field will be ignored. Ignored for
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnOverrideActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether distance and transit time override
								from point B to point A is active. Ignored if distinct distances and
								transit times by direction are not supported by global settings of
								the system; otherwise, mandatory for Create, can be omitted for
								Update to avoid change. Ignored for
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnDistance" type="p0:DistanceType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance from point B to point A. Expressed in
								the default distance UOM for the application, as defined in the
								global settings. If defined, must be greater than zero. Ignored if
								this direction is not active for the distance and transit time
								override; otherwise, mandatory for Create, can be omitted for Update
								to keep the existing value. This direction is never active when
								distinct distances and transit times by direction are not supported
								by global settings of the system. If
								returnDistanceTransitOverrideBreakdown is provided, this field will
								be ignored. Ignored for processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnTransitTime" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The transit time from point B to point A. If
								defined, must be greater than zero. Ignored if this direction is not
								active for the distance and transit time override; otherwise,
								mandatory for Create, can be omitted for Update to keep the existing
								value. This direction is never active when distinct distances and
								transit times by direction are not supported by global settings of
								the system. If returnDistanceTransitOverrideBreakdown is provided,
								this field will be ignored. Ignored for
								processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceEngineCode" type="p0:ExternalEngineCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>Read only field. The distance engine vendor ID.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceEngineVersionCode" type="p0:ExternalEngineVersionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance engine version ID. If not specified,
								default distance engine is assumed. Ignored if operation is not
								Create or processRetrieveDistanceTransitTime.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DivisionCode" type="p0:DivisionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The division ID. Mandatory for Create. Ignored for
								Retrieve, Update and Delete. For processRetrieveDistanceTransitTime,
								if not specified, distance / transit time overrides will not be
								considered for calculation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemTariffNumber" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The system-generated tariff ID. SystemTariffNumber
								and TariffServiceCode must be both supplied or both be null. Ignored
								for Retrieve, Update and Delete. For
								processRetrieveDistanceTransitTime, if not specified, distance /
								transit time overrides specific for this tariff / service will not
								be considered for calculation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TariffServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The tariff service ID. SystemTariffNumber and
								TariffServiceCode must be both supplied or both be null. Ignored for
								Retrieve, Update and Delete. For processRetrieveDistanceTransitTime,
								if not specified, distance / transit time overrides specific for
								this tariff / service will not be considered for calculation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceTransitOverrideBreakdown" type="p0:DistanceTransitTimeOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation><![CDATA[The distance transit time override breakdown for
								location 1 to 2, if available. Not for UI API because it needs to
								check RET_YN='F' in the breakdown record.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DistanceTransitOverrideBreakdownString" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance transit time override breakdowns coded
								in a string for location 1 to 2, if available. String contains
								multiple breakdowns. Format of this string for each breakdown is
								represented by Distance|Transit Time in minutes|State Code|Country
								Code. For countries other than Mexico, Canada and USA, the state
								code will be empty. Read only.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnDistanceTransitOverrideBreakdown" type="p0:DistanceTransitTimeOverrideBreakdownType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation><![CDATA[The distance transit time override breakdown for
								location 2 to 1, if available. If returnOverrideActiveFlag is not
								true or system is not directional, will be ignored when used as
								input. Not for UI API because it needs to check RET_YN='T' in the
								breakdown record.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReturnDistanceTransitOverrideBreakdownString" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The distance transit time override breakdown coded
								in a string for location 2 to 1, if available. String contains
								multiple breakdowns. Format of this string for each breakdown is
								represented by Distance|Transit Time in minutes|State Code|Country
								Code. For countries other than Mexico, Canada and USA, the state
								code will be empty. Read only.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CreatedByUserCode" type="p0:UserCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the user who created the entry. Read only
								field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UpdatedByUserCode" type="p0:UserCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the user who updated the entry. Read only
								field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CreatedDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The date and time when the entry was created. Read
								only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="UpdatedDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The date and time when the entry was updated. Read
								only field.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="DistributionCenterType"><xsd:annotation><xsd:documentation>A physical location where merchandise is stored, shipped,
