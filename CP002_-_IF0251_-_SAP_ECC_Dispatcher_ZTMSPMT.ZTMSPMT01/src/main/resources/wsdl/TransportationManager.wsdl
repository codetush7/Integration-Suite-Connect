								Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Memo" type="p0:MemoType" minOccurs="0"><xsd:annotation><xsd:documentation>A memo associated with the rate quotation.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="WeightByFreightClass" type="p0:WeightByFreightClassType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>The weight by freight classes associated with the
								rate quotation.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ARRatingInformation" type="p0:RatingInformationType" minOccurs="0"><xsd:annotation><xsd:documentation>A/R rating information.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="APRatingInformation" type="p0:RatingInformationType" minOccurs="0"><xsd:annotation><xsd:documentation>A/P rating information.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RateQuotationItineraryPoint" type="p0:RateQuotationItineraryPointType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>The itinerary associated with the rate quotation.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RateQuotationLeg" type="p0:RateQuotationLegType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>The rate quotation legs associated with the rate
