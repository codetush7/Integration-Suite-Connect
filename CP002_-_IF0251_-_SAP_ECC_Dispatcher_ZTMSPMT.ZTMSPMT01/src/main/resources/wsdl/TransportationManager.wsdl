								Scheduled Date/Time.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="OriginShippingLocation" type="p0:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>List of First Stop Shipping Locations.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DestinationShippingLocation" type="p0:StopShippingLocationType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>List of Last Stop Shipping Locations.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadSelectionCriteriaType"><xsd:annotation><xsd:documentation>The criteria for identifying a set of loads.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="LoadCategoryEnumVal" type="p0:LoadCategoryEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies built loads or manifest loads.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="FreightTermsEnumVal" type="p0:FreightTermsType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies loads paid for by a shipper or a carrier.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CurrentLoadOperationalStatusEnumVal" type="p0:LoadOperationalStatusEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies loads by their current operational
								status.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RetrieveLoadDataEnumVal" type="p0:RetrieveLoadDateEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies the type of date range on which to
								search.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="FromDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The earliest acceptable date and time stamp. Use a
								time of 00:00:00 to start from the beginning of the day.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ToDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The latest acceptable date and time stamp. Use a
								time of 23:59:59 to finish at the end of the day.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DivisionCode" type="p0:DivisionCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies loads by their assigned division.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies loads by their assigned carrier.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemPlanID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>Identifies loads by their plan.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ExcludedCarrierCode" type="p0:CarrierCodeType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>Identifies loads not assigned to any carrier in the
								collection.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadSpotRateDataType"><xsd:annotation><xsd:documentation>The system uses the data from this table to update the load.
						All fields are mandatory.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="SystemLoadID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>A system-generated load ID. Must belong to an
								existing load with valid rating results that is eligible for rating.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SpotRate" type="p0:DollarType" minOccurs="0"><xsd:annotation><xsd:documentation>The spot rate amount. Cannot be negative</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SpotRateCurrency" type="p0:CurrencyDomainValueType" minOccurs="0"><xsd:annotation><xsd:documentation>The currency code for the spotrate amount.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SuccessfulRatingRequiredFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the spot rate update is allowed
								based on the rating valid flag of the load. If this flag is true or
								not specified and rating valid flag of the load is false, update
								spot rate is not allowed.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="AllowVoucherReversalFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the A/P voucher is allowed to be
								reversed when updating the load spot rate. If this flag is false or
								not specified and A/P voucher of the load is created, update spot
								rate is not allowed.]]></xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadStatusUpdateDataType"><xsd:annotation><xsd:documentation>An event that describes the arrival and departure updates
						for a load.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="SystemLoadID" type="p0:ExternalXRefType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The load ID or reference number. If a carrier is
								supplied then will verify it is the correct one. Mandatory if
								IDsAreReferenceNumbersFlag (below) is true. Only 1 of systemLoadID,
								loadDescription, or masterBillOfLadingNumber may be supplied.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The load tracking number. If a carrier is supplied
								then will only search on that carrier. Only 1 of systemLoadID,
								loadDescription, or masterBillOfLadingNumber may be supplied.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the supplied IDs are load IDs or
								load reference numbers. If you use reference numbers for
								identification, they must be unique across all loads. If a supplied
								reference number is attached to two or more loads, this will
								generate an error. Optional.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReferenceNumberTypeCode" type="p0:ReferenceNumDomainValueType" minOccurs="0"><xsd:annotation><xsd:documentation>The type of reference numbers used to identify the
								loads. Mandatory if IDsAreReferenceNumbersFlag (above) is true.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>A carrier code that is only used to help identify a
								load. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="MasterBillOfLadingNumber" type="p0:ExternalXRefType" minOccurs="0"><xsd:annotation><xsd:documentation>The master BOL number. Only 1 of systemLoadID,
								loadDescription, or masterBillOfLadingNumber may be supplied.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor number. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor owner carrier code. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer number. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer owner carrier code. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>In-gate date and time.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTimeActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether InGateDateTime is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StopArrivalDepartureData" type="p0:StopArrivalDepartureDataType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation><![CDATA[Arrival and Departure Times and Events for a stop.
								If a stop is PICK/DROP then you can specify a
								StopArrivalDepartureDataType for each event. Optional.]]></xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadTenderContactType"><xsd:annotation><xsd:documentation>Contact information for a load tender.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadTenderContactTypeEnumVal" type="p0:LoadTenderContactEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates the tender contact type: carrier or
								sender. Mandatory. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadTenderContactTypeEnumDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for loadTenderContactTypeEnumVal.
								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ContactName" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>The name of the contact. Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LanguageCode" type="p0:LanguageDomainValueType" minOccurs="0"><xsd:annotation><xsd:documentation>The language of the contact. Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LanguageCodeDescr" type="xsd:string" minOccurs="0"><xsd:annotation><xsd:documentation>Description for languageCode. Read-only. Available
								only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Phone" type="p0:TelephoneType" minOccurs="0"><xsd:annotation><xsd:documentation>The phone number of the contact. Optional.
								Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="AlternatePhone" type="p0:TelephoneType" minOccurs="0"><xsd:annotation><xsd:documentation>The alternative phone number of the contact.
								Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Fax" type="p0:FaxType" minOccurs="0"><xsd:annotation><xsd:documentation>The fax number of the contact. Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Email" type="p0:EmailType" minOccurs="0"><xsd:annotation><xsd:documentation>The email address of the contact. Optional.
								Updatable.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="URL" type="p0:URLType" minOccurs="0"><xsd:annotation><xsd:documentation>The web URL of the contact. Optional. Updatable.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadTenderDataType"><xsd:annotation><xsd:documentation><![CDATA[The tender information for a load. CarrierCode and
						ServiceCode ensure that the caller is accepting or rejecting the correct
						tender information. That is, they ensure that the carrier and service have
						not changed since the caller retrieved the tender information. This is
						especially important if auto-tendering is active, because the automatic
						tendering process could time out a carrier and service. It would then
						proceed to the next eligible pair for a load between the time that the
						caller retrieves tender information, and calls the tender accept or tender
						reject service. CurrentLoadOperationalStatusEnumVal is mandatory for tender
						reject and tender cancel operations to ensure that a tender is not
						accidentally rejected or cancelled after it has already been accepted by
						someone else. For fax and email notifications, you can override the default
						settings in CarrierNotification, with the following restrictions: * If the
						load must be re-rated, the user override information supplied in
						CarrierNotification is disregarded, and the information for the new tariff
						service defaults is used instead. The remaining restrictions assume the Load
						has not been re-rated. * If any of autofax or autoemail notifications are
						enabled, the caller may disable the notification using CarrierNotification
						field. * If autofax or autoemail is enabled in global defaults level, but
						disabled for a given carrier and service combination, you can override this
						setting to enable the notification. * Note that a fax number or email
						address must be available either from your overrides, or from the tariff
						service setup.]]></xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="SystemLoadID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The load ID. Mandatory for all load tender
								operations.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemTenderRequestID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The tender request ID associated with the load. Read
								Only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The ID of the carrier for the load. Can always be
								set except for Tender Update operation where it is not updatable.
								Mandatory for Tender Accept, Tender Reject, and Tender Cancel.
								Optional for Tender.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCommittedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the load has been committed to its
								carrier. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The ID of the master service for the load. Not
								updatable for Tender Update operation, otherwise, can always be set
								and is always optional. When it is set and not for tender, it is
								used for validation only.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceCommittedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the load has been committed to its
								master service. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer equipment type code. Can only be set
								during Tender, Tender Accept and is optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EquipmentTypeCommittedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the trailer equipment type is
								committed. Read only field.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorEquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor equipment type. Can only be set during
								Tender, Tender Accept.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor domicile code. Can only be set during
								Tender.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTrailerCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer domicile code. Can only be set during
								Tender.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TenderAcceptedBy" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The name of the employee who accepted the tender.
								Can be set during Tender (optional unless AutoAcceptControlEnumVal
								is set to AUTOACCEPTCTRL_TRUE) and Tender Accept (mandatory). For
								Tender Update, it will be used only when status is Tendered and
								AutoAcceptControlEnumVal is set to AUTOACCEPTCTRL_TRUE. Ignored for
								Tender Update if the load belongs to a booking or a trip level
								tender request.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CurrentLoadOperationalStatusEnumVal" type="p0:LoadOperationalStatusEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The current operational status of the load. Can only
								be set during Tender Reject or Tender Cancel and is mandatory then.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ActualCarrierService" type="p0:ExternalXRefType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The actual carrier and service for this load tender,
								if using a virtual carrier such as NTE. Can only be set during
								Tender Accept and is optional then.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ActualCostAmount" type="p0:DollarType" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[The actual cost of this load tender, if using a
								virtual carrier such as NTE. Can only be set during Tender Accept
								and is optional then.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="Memo" type="p0:MemoType" minOccurs="0"><xsd:annotation><xsd:documentation>A memo for the load. Can always be set and is always
								optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EventInformation" type="p0:EventInformationType" minOccurs="0"><xsd:annotation><xsd:documentation>The Reason Code information. Can only be set during
								Tender Reject, Tender Cancel or Tender Update and is optional then.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierNotification" type="p0:TenderNotificationDataType" minOccurs="0"><xsd:annotation><xsd:documentation>The carrier notification information. Can only be
								set during Tender, Tender Cancel or Tender Update and is optional
								then.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemTripID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The trip that this load is on. Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadSequenceNumber" type="p0:ShortType" minOccurs="0"><xsd:annotation><xsd:documentation>The sequence number of this load on its trip.
								Read-only.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="RevisionToPreviouslyAcceptedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates if there was a revision to an accepted
								load tender. Can always be set and is always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer number. Can always be set and is always
								optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The carrier that owns the trailer. Can always be set
								and is always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer license number. Can always be set and is
								always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor number. Can only be set during Tender,
								Tender Accept.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The carrier that owns the tractor. Can always be set
								and is always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor license number. Can always be set and is
								always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DriverCode" type="p0:DriverIdType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the driver. Can always be set and is
								always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DriverLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The license number of the driver. Can always be set
								and is always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SealNumber" type="p0:SealNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The seal number. Can always be set and is always
								optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>In-gate date and time.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTimeActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether InGateDateTime is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrackingNumber" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>The tracking number. Always optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="IgnoreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the contents of
								referenceNumberStructure (next) should be ignored. Applicable only
								for processTenderAccept operation.]]></xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ReferenceNumberStructure" type="p0:ReferenceNumberType" minOccurs="0" maxOccurs="unbounded"><xsd:annotation><xsd:documentation>Reference numbers attached to the load. Optional.
								Applicable only for processTenderAccept operation.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="LoadUpdateDataType"><xsd:annotation><xsd:documentation>Information about a load update.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="SystemLoadID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The ID of the load to be updated. Mandatory. Cannot
								be updated.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>Load tracking number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The carrier code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="ServiceCode" type="p0:ServiceCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The service code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="EquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer equipment type.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorEquipmentTypeCode" type="p0:EquipmentCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor equipment type.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor domicile code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DomicileTrailerCode" type="p0:DomicileCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer domicile code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="CommodityCode" type="p0:CommodityCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>The commodity code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadScheduledDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The load scheduled date.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadCompositionApprovedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether the load composition is approved.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The trailer number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DriverCode" type="p0:DriverIdType" minOccurs="0"><xsd:annotation><xsd:documentation>The driver code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SealNumber" type="p0:SealNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The seal number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>Trailer owner carrier code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TrailerLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>Trailer license number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorNumber" type="p0:TrailerNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>The tractor number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorOwnerCarrierCode" type="p0:CarrierCodeType" minOccurs="0"><xsd:annotation><xsd:documentation>Tractor owner carrier code.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TractorLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>Tractor license plate number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="DriverLicenseNumber" type="p0:LicenseNumberType" minOccurs="0"><xsd:annotation><xsd:documentation>Driver license number.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>In-gate date and time.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="InGateDateTimeActiveFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether InGateDateTime is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadScheduleCompletedFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation>Indicates whether scheduling is active for the load.
								The default value is True.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadStartDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The start date. Ignored if scheduling is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadEndDateTime" type="xsd:dateTime" minOccurs="0"><xsd:annotation><xsd:documentation>The end date. Ignored if scheduling is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalLoadingHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total loading time. Ignored if scheduling is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalUnloadingHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total unloading time. Ignored if scheduling is
								active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalDrivingHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total driving time. Ignored if scheduling is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalWaitHoursForLoad" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total waiting time for the load. Ignored if
								scheduling is active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalOnDutyHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total time on duty. Ignored if
								loadScheduleCompletedFlag is true.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="TotalOffDutyHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>Total time off duty. Ignored if scheduling is
								active.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="WeekendHolidayBreakHours" type="p0:HoursType" minOccurs="0"><xsd:annotation><xsd:documentation>The weekend holiday break hours. Ignored if
