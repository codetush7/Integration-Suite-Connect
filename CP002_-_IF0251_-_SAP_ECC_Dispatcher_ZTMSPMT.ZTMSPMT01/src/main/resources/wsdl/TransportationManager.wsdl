								Read-only. Available only through UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element></xsd:sequence></xsd:complexType><xsd:complexType name="StopAppointmentType"><xsd:annotation><xsd:documentation>Details of the Stop appointment.</xsd:documentation></xsd:annotation><xsd:sequence><xsd:element name="Id" type="p0:IDType" minOccurs="0"><xsd:annotation><xsd:documentation>Internal ID. Applicable only for UI-oriented APIs.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="StopIDTypeEnumVal" type="p0:StopIdTypeEnumValType" minOccurs="0"><xsd:annotation><xsd:documentation>The type of stop identification. Mandatory.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="SystemLoadID" type="p0:KeyStringType" minOccurs="0"><xsd:annotation><xsd:documentation>The load ID or reference number. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="LoadDescription" type="p0:NameType" minOccurs="0"><xsd:annotation><xsd:documentation>The load tracking number. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="MasterBillOfLadingNumber" type="p0:ExternalXRefType" minOccurs="0"><xsd:annotation><xsd:documentation>The master BOL number. Optional.</xsd:documentation></xsd:annotation></xsd:element><xsd:element name="IDsAreReferenceNumbersFlag" type="xsd:boolean" minOccurs="0"><xsd:annotation><xsd:documentation><![CDATA[Indicates whether the supplied IDs are load IDs or
